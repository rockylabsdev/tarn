{
  "env": {
    "CLAUDE_CODE_SHELL": "/bin/bash"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-self-pkill.sh"
          }
        ]
      }
    ]
  }
}
